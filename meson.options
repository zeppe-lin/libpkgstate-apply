option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'How this adapter links against its authority dependencies',
)

option(
  'tests',
  type: 'feature',
  value: 'enabled',
  description: 'Build and run the adapter test suite',
)

option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Build the manual page with scdoc',
)

option(
  'html_docs',
  type: 'feature',
  value: 'disabled',
  description: 'Generate and install versioned static HTML documentation',
)
